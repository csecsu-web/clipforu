{
  "name": "Clipforu private clipper",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && python -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "containerEnv": {
    "CLIPS_DIR": "${containerWorkspaceFolder}/clips",
    "CLIP_WORK_DIR": "${containerWorkspaceFolder}/work",
    "WHISPER_MODEL": "base",
    "MAX_UPLOAD_GB": "20",
    "JOB_TTL_HOURS": "6"
  },
  "forwardPorts": [5050],
  "portsAttributes": {
    "5050": {
      "label": "Private Clipforu",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}
